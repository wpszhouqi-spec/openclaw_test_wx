# Vector backend: milvus | local | auto (prefer milvus, fall back to local)
RAG_STORE=auto

# Milvus
MILVUS_ADDRESS=127.0.0.1:19530
MILVUS_COLLECTION=openclaw_rag_chunks
MILVUS_TIMEOUT_MS=5000

# Retrieval
RAG_TOP_K=4
RAG_HIT_THRESHOLD=0.28
RAG_EMBED_DIM=384

# Knowledge corpus (markdown / text)
RAG_KNOWLEDGE_DIR=./knowledge

# Local JSON vector cache (used when Milvus is unavailable)
RAG_LOCAL_PATH=./data/local-vectors.json

# OpenClaw framework fallback
OPENCLAW_ROOT=..
OPENCLAW_AGENT_BIN=../openclaw.mjs
OPENCLAW_AGENT_ID=main
OPENCLAW_MODEL=minimax/MiniMax-M3

# Optional: when RAG hits, answer via OpenClaw agent with retrieved context
RAG_ANSWER_VIA_OPENCLAW=1
